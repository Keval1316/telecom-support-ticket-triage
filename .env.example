# =========================================================
# TELECOM TICKET TRIAGE — ENVIRONMENT CONFIG TEMPLATE
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# =========================================================

# --- Groq (OFFLINE data-generation only — never used at runtime) ---
# Comma-separated list, supports 1-N keys for rotation across accounts
GROQ_API_KEYS=key1,key2,key3
# Verify current valid model name before Phase 3 (Groq model names change)
GROQ_MODEL=
GENERATION_BATCH_SIZE=25
TARGET_DATASET_SIZE=2000
RANDOM_SEED=42
DATASET_VERSION=v1.0
# --- Model paths (used at runtime — no Groq involved) ---
MODEL_PATH=./models/base/Qwen2.5-3B
ADAPTER_PATH=./models/adapters/telecom-ticket-triage
MAX_SEQUENCE_LENGTH=512

# --- Database ---
DATABASE_URL=sqlite:///./backend/triage.db

# --- Inference / Routing ---
CONFIDENCE_THRESHOLD=0.80
BATCH_SIZE=8

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
