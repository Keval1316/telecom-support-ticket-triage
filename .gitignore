# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Model weights & large artifacts ---
models/base/*
!models/base/.gitkeep
models/adapters/telecom-ticket-triage/*
!models/adapters/telecom-ticket-triage/.gitkeep
*.safetensors
*.bin
*.gguf
*.pt
*.ckpt

# --- Data (large raw/intermediate files excluded; curated splits and eval csvs tracked) ---
data/raw/*.jsonl
data/raw/*.json
data/processed/*.jsonl
data/processed/*.json


# --- Prepared HuggingFace Datasets (binary arrow files — not tracked, regenerable) ---
training/prepared/train/
training/prepared/validation/
training/prepared/test/
# training/prepared/meta.json is small and IS tracked (kept)

# --- Database ---
*.db
*.sqlite3
backend/*.db

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# --- Logs ---
*.log
logs/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Docker ---
*.pid
