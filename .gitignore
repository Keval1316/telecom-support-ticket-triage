# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Model weights & large artifacts ---
models/base/*
!models/base/.gitkeep
models/adapters/telecom-ticket-triage/*
!models/adapters/telecom-ticket-triage/.gitkeep
*.safetensors
*.bin
*.gguf
*.pt
*.ckpt

# --- Data (raw/generated datasets are big & regenerable; keep manifests/reports) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/**/*.csv
data/future_testing/*.csv
data/evaluation/*.csv
data/demo/*.csv
!data/demo/sample_upload.csv

# --- Prepared HuggingFace Datasets (binary arrow files — not tracked, regenerable) ---
training/prepared/train/
training/prepared/validation/
training/prepared/test/
# training/prepared/meta.json is small and IS tracked (kept)

# --- Database ---
*.db
*.sqlite3
backend/*.db

# --- Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# --- Logs ---
*.log
logs/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/

# --- Docker ---
*.pid
